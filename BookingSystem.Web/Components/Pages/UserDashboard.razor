@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BookingSystem.Web.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager

<h3>User Dashboard</h3>

<p class="text-muted">View your appointments and manage your account requests.</p>

<hr />

<h5>My Appointments</h5>

@if (isLoadingAppointments)
{
    <p><em>Loading appointments...</em></p>
}
else if (appointments.Count == 0)
{
    <div class="alert alert-info">You do not have any appointments yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Service</th>
                <th>Business</th>
                <th>Employee</th>
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appt in appointments)
            {
                <tr>
                    <td>@appt.Start.ToString("yyyy-MM-dd")</td>
                    <td>@appt.ServiceName</td>
                    <td>@appt.BusinessName</td>
                    <td>@appt.EmployeeName</td>
                    <td>@appt.Start.ToString("hh:mm tt") - @appt.End.ToString("hh:mm tt")</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

@if (isEntrepreneur)
{
    <div class="alert alert-success">
        You're already an entrepreneur 🎉
    </div>
}
else if (hasPendingRequest)
{
    <div class="alert alert-warning">
        Your application is currently under review ⏳
    </div>
}
else
{
    <button class="btn btn-primary" @onclick="RequestEntrepreneur">
        Becoming an entrepreneur
    </button>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@code {
    private string? currentUserId;
    private bool isEntrepreneur = false;
    private bool hasPendingRequest = false;
    private string message = "";
    private bool isLoadingAppointments = true;
    private List<UserAppointmentViewModel> appointments = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        var user = await UserManager.GetUserAsync(userPrincipal);

        if (user != null)
        {
            currentUserId = user.Id;

            // Verificar si ya es emprendedor
            isEntrepreneur = await UserManager.IsInRoleAsync(user, "Entrepreneur");

            // Verificar si ya tiene solicitud pendiente
            hasPendingRequest = await DbContext.EntrepreneurRequests
                .AnyAsync(r => r.UserId == user.Id && !r.IsApproved);

            await LoadAppointmentsAsync(user.Id);
        }
        else
        {
            isLoadingAppointments = false;
        }
    }

    private async Task LoadAppointmentsAsync(string userId)
    {
        appointments = await DbContext.Appointments
            .AsNoTracking()
            .Include(a => a.BusinessService)
                .ThenInclude(s => s!.Business)
            .Include(a => a.Employee)
            .Where(a => !a.IsCancelled && a.ClientUserId == userId)
            .OrderByDescending(a => a.AppointmentStart)
            .Select(a => new UserAppointmentViewModel(
                a.AppointmentStart,
                a.AppointmentEnd,
                a.BusinessService != null ? a.BusinessService.Name : "Unknown service",
                a.BusinessService != null && a.BusinessService.Business != null ? a.BusinessService.Business.Name : "Unknown business",
                a.Employee != null ? a.Employee.Name : "Unknown employee"))
            .ToListAsync();

        isLoadingAppointments = false;
    }

    private async Task RequestEntrepreneur()
    {
        message = "CLICK detectado 👀";
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        var user = await UserManager.GetUserAsync(userPrincipal);


        if (user == null) return;

        // Seguridad extra: evitar duplicados
        var exists = await DbContext.EntrepreneurRequests
            .AnyAsync(r => r.UserId == user.Id && !r.IsApproved);

        if (exists)
        {
            message = "You already have a pending application.";
            return;
        }

        var request = new EntrepreneurRequest
        {
            UserId = user.Id
        };

        DbContext.EntrepreneurRequests.Add(request);
        await DbContext.SaveChangesAsync();

        hasPendingRequest = true;
        message = "Request sent successfully";
    }

    private record UserAppointmentViewModel(
        DateTime Start,
        DateTime End,
        string ServiceName,
        string BusinessName,
        string EmployeeName);
}