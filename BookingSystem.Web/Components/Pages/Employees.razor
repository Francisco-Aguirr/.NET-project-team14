@page "/entrepreneur/employees"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BookingSystem.Web.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize(Roles = "Entrepreneur")]

<PageTitle>My Employees</PageTitle>
<h3>My Employees</h3>

@if (!string.IsNullOrWhiteSpace(pageMessage))
{
    <div class="alert alert-warning">@pageMessage</div>
}

@if (employees == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="ShowAddEmployee" disabled="@(currentBusinessId is null)">Add
        Employee</button>

        @if (employees.Count == 0)
        {
            <p><em>No employees yet.</em></p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in employees)
                    {
                        <tr>
                            <td>@emp.Name</td>
                            <td>@emp.Phone</td>
                            <td>
                                <button class="btn btn-sm btn-info me-2" @onclick="() => EditEmployee(emp)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteEmployee(emp.Id)">Delete</button>
                                <button class="btn btn-sm btn-secondary ms-2" @onclick="() => ShowSchedules(emp)">Schedules</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (showEmployeeForm)
    {
        <EditForm Model="employeeModel" OnValidSubmit="SaveEmployee" FormName="entrepreneur-employee-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-2">
                <label>Name:</label>
                <InputText class="form-control" @bind-Value="employeeModel.Name" />
            </div>
            <div class="mb-2">
                <label>Phone:</label>
                <InputText class="form-control" @bind-Value="employeeModel.Phone" />
            </div>
            <button class="btn btn-success me-2" type="submit">Save</button>
            <button class="btn btn-secondary" type="button" @onclick="CancelEmployee">Cancel</button>
        </EditForm>
    }

    @if (showSchedules && selectedEmployee != null)
    {
        <h4>Schedules for @selectedEmployee.Name</h4>
        @if (!string.IsNullOrWhiteSpace(scheduleValidationError))
        {
            <div class="alert alert-warning">@scheduleValidationError</div>
        }
        <button class="btn btn-sm btn-primary mb-2" @onclick="ShowAddSchedule">Add Schedule</button>
        <table class="table">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sched in schedules)
                {
                    <tr>
                        <td>@sched.DayOfWeek</td>
                        <td>@sched.StartTime</td>
                        <td>@sched.EndTime</td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteSchedule(sched.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (showScheduleForm)
        {
            <EditForm Model="scheduleModel" OnValidSubmit="SaveSchedule" FormName="entrepreneur-schedule-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-2">
                    <label>Day of Week:</label>
                    <InputSelect class="form-control" @bind-Value="scheduleModel.DayOfWeek">
                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                        {
                            <option value="@day">@day</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-2">
                    <label>Start Time:</label>
                    <InputText class="form-control" type="time" @bind-value="startTimeString" />
                </div>
                <div class="mb-2">
                    <label>End Time:</label>
                    <InputText class="form-control" type="time" @bind-value="endTimeString" />
                </div>
                <button class="btn btn-success me-2" type="submit">Save</button>
                <button class="btn btn-secondary" type="button" @onclick="CancelSchedule">Cancel</button>
            </EditForm>
        }
        <button class="btn btn-secondary mt-2" @onclick="CloseSchedules">Close</button>
    }

@code {
    private List<Employee>? employees;
    private Employee employeeModel = new();
    private bool showEmployeeForm = false;
    private bool isEdit = false;

    private List<WorkSchedule> schedules = new();
    private WorkSchedule scheduleModel = new();
    private string startTimeString = "";
    private string endTimeString = "";
    private bool showSchedules = false;
    private bool showScheduleForm = false;
    private Employee? selectedEmployee;
    private string? scheduleValidationError;

    private string? currentUserId;
    private int? currentBusinessId;
    private string pageMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user == null)
        {
            pageMessage = "Unable to identify authenticated entrepreneur.";
            employees = new List<Employee>();
            return;
        }

        currentUserId = user.Id;
        var business = await DbContext.Businesses.FirstOrDefaultAsync(b => b.UserId == currentUserId);

        if (business == null)
        {
            pageMessage = "Create your business profile first before managing employees.";
            employees = new List<Employee>();
            return;
        }

        currentBusinessId = business.Id;
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        if (currentBusinessId is null)
        {
            employees = new List<Employee>();
            return;
        }

        employees = await DbContext.Employees
            .Where(e => e.BusinessId == currentBusinessId.Value)
            .OrderBy(e => e.Name)
            .ToListAsync();
    }

    private void ShowAddEmployee()
    {
        employeeModel = new Employee
        {
            BusinessId = currentBusinessId
        };
        showEmployeeForm = true;
        isEdit = false;
    }

    private void EditEmployee(Employee emp)
    {
        employeeModel = new Employee
        {
            Id = emp.Id,
            Name = emp.Name,
            Phone = emp.Phone,
            BusinessId = emp.BusinessId
        };
        showEmployeeForm = true;
        isEdit = true;
    }

    private async Task SaveEmployee()
    {
        if (currentBusinessId is null)
        {
            pageMessage = "Business context not found.";
            return;
        }

        if (isEdit)
        {
            var emp = await DbContext.Employees
                .FirstOrDefaultAsync(e => e.Id == employeeModel.Id && e.BusinessId == currentBusinessId.Value);

            if (emp != null)
            {
                emp.Name = employeeModel.Name;
                emp.Phone = employeeModel.Phone;
            }
        }
        else
        {
            employeeModel.BusinessId = currentBusinessId.Value;
            DbContext.Employees.Add(employeeModel);
        }

        await DbContext.SaveChangesAsync();
        showEmployeeForm = false;
        await LoadEmployees();
    }

    private void CancelEmployee()
    {
        showEmployeeForm = false;
    }

    private async Task DeleteEmployee(int id)
    {
        if (currentBusinessId is null)
        {
            return;
        }

        var emp = await DbContext.Employees
            .FirstOrDefaultAsync(e => e.Id == id && e.BusinessId == currentBusinessId.Value);

        if (emp != null)
        {
            DbContext.Employees.Remove(emp);
            await DbContext.SaveChangesAsync();
            await LoadEmployees();
        }
    }

    private async Task ShowSchedules(Employee emp)
    {
        if (currentBusinessId is null || emp.BusinessId != currentBusinessId.Value)
        {
            return;
        }

        selectedEmployee = emp;
        schedules = await DbContext.WorkSchedules
            .Where(ws => ws.EmployeeId == emp.Id)
            .ToListAsync();
        showSchedules = true;
        showScheduleForm = false;
        scheduleValidationError = null;
    }

    private void ShowAddSchedule()
    {
        scheduleModel = new WorkSchedule { EmployeeId = selectedEmployee!.Id };
        startTimeString = "08:00";
        endTimeString = "17:00";
        showScheduleForm = true;
        scheduleValidationError = null;
    }

    private async Task SaveSchedule()
    {
        if (TimeSpan.TryParse(startTimeString, out var start) && TimeSpan.TryParse(endTimeString, out var end))
        {
            if (end <= start)
            {
                scheduleValidationError = "End time must be later than start time.";
                return;
            }

            scheduleModel.StartTime = start;
            scheduleModel.EndTime = end;
            DbContext.WorkSchedules.Add(scheduleModel);
            await DbContext.SaveChangesAsync();
            showScheduleForm = false;
            scheduleValidationError = null;
            schedules = await DbContext.WorkSchedules
                .Where(ws => ws.EmployeeId == selectedEmployee!.Id)
                .ToListAsync();
        }
        else
        {
            scheduleValidationError = "Please enter valid start and end times.";
        }
    }

    private void CancelSchedule()
    {
        showScheduleForm = false;
        scheduleValidationError = null;
    }

    private async Task DeleteSchedule(int id)
    {
        var sched = await DbContext.WorkSchedules.FindAsync(id);
        if (sched != null && selectedEmployee != null && sched.EmployeeId == selectedEmployee.Id)
        {
            DbContext.WorkSchedules.Remove(sched);
            await DbContext.SaveChangesAsync();
            schedules = await DbContext.WorkSchedules
                .Where(ws => ws.EmployeeId == selectedEmployee.Id)
                .ToListAsync();
        }
    }

    private void CloseSchedules()
    {
        showSchedules = false;
        selectedEmployee = null;
        schedules.Clear();
        scheduleValidationError = null;
    }
}
