@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "SuperAdmin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using BookingSystem.Web.Data

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager

<h3>Admin Dashboard</h3>

<hr />

<h4>Applications from entrepreneurs</h4>

@if (requests == null)
{
    <p><em>Loading...</em></p>
}
else if (!requests.Any())
{
    <p>There are no pending requests.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var req in requests)
            {
                <tr>
                    <td>@req.UserEmail</td>
                    <td>@req.RequestedAt.ToLocalTime()</td>
                    <td>
                        <button class="btn btn-success btn-sm me-1"
                                disabled="@isProcessing"
                                @onclick="() => Approve(req)">
                            Approve
                        </button>

                        <button class="btn btn-danger btn-sm"
                                disabled="@isProcessing"
                                @onclick="() => ConfirmDeleteRequest(req)">
                            Reject
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h4>Business Categories</h4>

<div class="d-flex gap-2 mb-3">
    <input class="form-control"
           placeholder="New category"
           @bind="newCategory" />

    <button class="btn btn-primary"
            disabled="@string.IsNullOrWhiteSpace(newCategory)"
            @onclick="AddCategory">
        Add
    </button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

@if (categories == null)
{
    <p><em>Loading...</em></p>
}
else if (!categories.Any())
{
    <p>No categories yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th style="width: 200px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in categories)
            {
                <tr>
                    <td>
                        @if (editingCategoryId == cat.Id)
                        {
                            <input class="form-control"
                                   @bind="editingCategoryName" />
                        }
                        else
                        {
                            @cat.Name
                        }
                    </td>
                    <td>
                        @if (editingCategoryId == cat.Id)
                        {
                            <button class="btn btn-success btn-sm me-1"
                                    @onclick="UpdateCategory">
                                Save
                            </button>

                            <button class="btn btn-secondary btn-sm"
                                    @onclick="CancelEdit">
                                Cancel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-warning btn-sm me-1"
                                    @onclick="() => StartEdit(cat)">
                                Edit
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => ConfirmDeleteCategory(cat.Id)">
                                Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RequestViewModel> requests = new();
    private List<BusinessCategory> categories = new();

    private string newCategory = "";

    private int? editingCategoryId = null;
    private string editingCategoryName = "";

    private bool isProcessing = false;
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var dbRequests = await DbContext.EntrepreneurRequests
            .Where(r => !r.IsApproved)
            .ToListAsync();

        requests = new();

        foreach (var req in dbRequests)
        {
            var user = await UserManager.FindByIdAsync(req.UserId);

            if (user != null)
            {
                requests.Add(new RequestViewModel
                {
                    Id = req.Id,
                    UserId = user.Id,
                    UserEmail = user.Email!,
                    RequestedAt = req.RequestedAt
                });
            }
        }

        categories = await DbContext.BusinessCategories.ToListAsync();
    }

    private async Task Approve(RequestViewModel req)
    {
        isProcessing = true;

        var dbReq = await DbContext.EntrepreneurRequests.FindAsync(req.Id);

        if (dbReq != null)
        {
            dbReq.IsApproved = true;

            var user = await UserManager.FindByIdAsync(req.UserId);

            if (user != null)
            {
                await UserManager.AddToRoleAsync(user, "Entrepreneur");
            }

            await DbContext.SaveChangesAsync();
            message = "User approved successfully";
        }

        await LoadData();
        isProcessing = false;
    }

    private async Task ConfirmDeleteRequest(RequestViewModel req)
    {
        if (await JSConfirm("Are you sure you want to reject this request?"))
        {
            await Reject(req);
        }
    }

    private async Task Reject(RequestViewModel req)
    {
        isProcessing = true;

        var dbReq = await DbContext.EntrepreneurRequests.FindAsync(req.Id);

        if (dbReq != null)
        {
            DbContext.EntrepreneurRequests.Remove(dbReq);
            await DbContext.SaveChangesAsync();
            message = "Request rejected";
        }

        await LoadData();
        isProcessing = false;
    }

    private async Task AddCategory()
    {
        if (!string.IsNullOrWhiteSpace(newCategory))
        {
            DbContext.BusinessCategories.Add(new BusinessCategory
            {
                Name = newCategory
            });

            await DbContext.SaveChangesAsync();

            newCategory = "";
            message = "Category added";

            await LoadData();
        }
    }

    private void StartEdit(BusinessCategory cat)
    {
        editingCategoryId = cat.Id;
        editingCategoryName = cat.Name;
    }

    private void CancelEdit()
    {
        editingCategoryId = null;
        editingCategoryName = "";
    }

    private async Task UpdateCategory()
    {
        if (editingCategoryId != null &&
            !string.IsNullOrWhiteSpace(editingCategoryName))
        {
            var cat = await DbContext.BusinessCategories
                .FindAsync(editingCategoryId);

            if (cat != null)
            {
                cat.Name = editingCategoryName;
                await DbContext.SaveChangesAsync();
                message = "Category updated";
            }

            CancelEdit();
            await LoadData();
        }
    }

    private async Task ConfirmDeleteCategory(int id)
    {
        if (await JSConfirm("Are you sure you want to delete this category?"))
        {
            await DeleteCategory(id);
        }
    }

    private async Task DeleteCategory(int id)
    {
        var cat = await DbContext.BusinessCategories.FindAsync(id);

        if (cat != null)
        {
            DbContext.BusinessCategories.Remove(cat);
            await DbContext.SaveChangesAsync();
            message = "Category deleted";

            await LoadData();
        }
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task<bool> JSConfirm(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private class RequestViewModel
    {
        public int Id { get; set; }
        public string UserId { get; set; } = "";
        public string UserEmail { get; set; } = "";
        public DateTime RequestedAt { get; set; }
    }
}
