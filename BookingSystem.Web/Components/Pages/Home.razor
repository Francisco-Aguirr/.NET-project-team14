@page "/"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using BookingSystem.Web.Data

@inject ApplicationDbContext DbContext
@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<h1 class="mb-4">Explore Businesses</h1>

<hr />

@if (businesses == null)
{
    <p>Loading businesses...</p>
}
else if (!businesses.Any())
{
    <p>No businesses available yet.</p>
}
else
{
    <div class="row">
        @foreach (var business in businesses)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@business.Name</h5>
                        <p class="card-text">@business.Description</p>

                        <p>
                            <strong>Category:</strong>
                            @business.BusinessCategory?.Name
                        </p>
                    </div>

                    <div class="card-footer text-center">
                        <button class="btn btn-primary" @onclick="() => GoToBusiness(business.Id)">
                            See Services
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Business> businesses = new();

    protected override async Task OnInitializedAsync()
    {
        businesses = await DbContext.Businesses
            .Include(b => b.BusinessCategory)
            .ToListAsync();
    }

    private void GoToBusiness(int businessId)
    {
        Nav.NavigateTo($"/business/{businessId}");
    }
}
