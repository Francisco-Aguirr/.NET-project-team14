@page "/"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using BookingSystem.Web.Data

@inject ApplicationDbContext DbContext
@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<h1 class="mb-4">Explore Businesses</h1>

<hr />

@if (businesses == null)
{
    <p>Loading businesses...</p>
}
else if (!businesses.Any())
{
    <p>No businesses available yet.</p>
}
else
{
    <div class="row">
        @foreach (var business in businesses)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <!-- IMAGE -->
                    <img src="@GetImageForBusiness(business.Id)" class="card-img-top" style="height:180px; object-fit:cover;" />

                    <div class="card-body">
                        <h5 class="card-title">@business.Name</h5>

                        <p class="text-muted mb-2">
                            Category: @business.BusinessCategory?.Name
                        </p>

                        <p class="card-text">
                            @business.Description
                        </p>
                    </div>

                    <div class="card-footer text-center bg-white border-0">
                        <button class="btn btn-outline-primary w-100" @onclick="() => GoToBusiness(business.Id)">
                            See Services
                        </button>
                    </div>

                </div>
            </div>
        }
    </div>
}

@code {
    private List<Business>? businesses;

    protected override async Task OnInitializedAsync()
    {
        businesses = await DbContext.Businesses
            .Include(b => b.BusinessCategory)
            .ToListAsync();
    }

    private void GoToBusiness(int businessId)
    {
        Nav.NavigateTo($"/business/{businessId}");
    }

    private List<string> businessImages = new()
    {
        "/images/business1.png",
        "/images/business2.png",
        "/images/business3.png",
        "/images/business4.png"
    };

    private Dictionary<int, string> businessImageMap = new();
    private string GetImageForBusiness(int businessId)
    {
        if (!businessImageMap.ContainsKey(businessId))
        {
            var random = new Random();
            var index = random.Next(businessImages.Count);
            businessImageMap[businessId] = businessImages[index];
        }

        return businessImageMap[businessId];
    }
}

